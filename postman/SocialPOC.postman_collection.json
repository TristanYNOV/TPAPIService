    {
      "name": "Posts — Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "5f19cf5e-b3bd-4b09-9c38-2eaf0db7f321",
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.code === 201);",
              "const json = pm.response.json();",
              "pm.test('Post payload includes id/content/author', () => {",
              "  pm.expect(json).to.have.property('id');",
              "  pm.expect(json).to.have.property('content');",
              "  pm.expect(json).to.have.property('author');",
              "});",
              "pm.environment.set('postId', json.id);",
              "if (json.author && json.author.id) {",
              "  pm.environment.set('targetUserId', json.author.id);",
              "}"
            ]
          }
        }
