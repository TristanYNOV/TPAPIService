    {
      "name": "Posts — List (me)",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "d5ae0e30-0363-4a30-a0c5-da59c5db12e0",
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.code === 200);",
              "const json = pm.response.json();",
              "pm.test('Shape {data,nextCursor}', () => {",
              "  pm.expect(json).to.have.property('data').that.is.an('array');",
              "  pm.expect(json).to.have.property('nextCursor');",
              "});",
              "const token = pm.environment.get('token');",
              "if (token) {",
              "  const parts = token.split('.');",
              "  if (parts.length >= 2) {",
              "    const normalized = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
              "    const padding = normalized.length % 4 === 0 ? 0 : 4 - (normalized.length % 4);",
              "    const padded = normalized + '='.repeat(padding);",
              "    try {",
              "      const payload = JSON.parse(Buffer.from(padded, 'base64').toString('utf8'));",
              "      if (payload && payload.sub) {",
              "        pm.test('Posts belong to the authenticated user', () => {",
              "          const allOwned = json.data.every((post) => post && post.author && post.author.id === payload.sub);",
              "          pm.expect(allOwned).to.be.true;",
              "        });",
              "      }",
              "    } catch (error) {",
              "      console.warn('Impossible de décoder le token pour vérifier les auteurs.', error);",
              "    }",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/posts?scope=me&limit={{limit}}",
          "host": [
