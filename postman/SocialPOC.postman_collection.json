    {
      "name": "Posts — Like",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}/like",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}",
            "like"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "e2d3bb6a-08d7-4a86-98cc-8551a152f6c2",
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.code === 200);",
              "const json = pm.response.json();",
              "pm.test('Like count is returned', () => {",
              "  pm.expect(json).to.have.property('likes').that.is.a('number');",
              "});",
              "const initialLikes = json.likes;",
              "const token = pm.environment.get('token');",
              "const postId = pm.environment.get('postId');",
              "const baseUrl = pm.environment.get('baseUrl') || pm.variables.get('baseUrl');",
              "if (token && postId && baseUrl) {",
              "  pm.sendRequest({",
              "    url: `${baseUrl}/posts/${postId}/like`,",
              "    method: 'POST',",
              "    header: {",
              "      Authorization: `Bearer ${token}`",
              "    }",
              "  }, function (err, res) {",
              "    pm.test('Re-like request succeeded', () => !err);",
              "    if (err) {",
              "      console.error('Re-like request failed', err);",
              "      return;",
              "    }",
              "    pm.test('Re-like returns 200', () => res.code === 200);",
              "    const body = res.json();",
              "    pm.test('Re-like keeps like counter unchanged', () => body.likes === initialLikes);",
              "  });",
              "} else {",
              "  console.warn('token/postId/baseUrl missing for re-like validation');",
              "}"
            ]
          }
        }
      ]
    },
